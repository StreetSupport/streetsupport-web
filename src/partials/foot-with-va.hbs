    <script src="{{site.url}}assets/js/commons.js?v={{cachebusting.date}}"></script>
    <script src="{{site.url}}assets/js/{{jsBundle}}.bundle.js?v={{cachebusting.date}}"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key={{site.googleMapsApiKey}}&callback=initMap"
    async defer></script>
    <script>
      let savedContext = {};
      let geoInstance;

      function tryGeo(attempts = 0) {
        if (!geoInstance) return;

        if (!navigator.geolocation) {
          sendLocationError({ code: -1, message: "No geolocation API" }, geoInstance);
          return;
        }

        navigator.geolocation.getCurrentPosition(
          pos => sendLocation(pos, geoInstance),
          err => {
            if (err.code === err.POSITION_UNAVAILABLE && attempts < 1) {
              setTimeout(() => tryGeo(attempts + 1), 2000);
            } else {
              sendLocationError(err, geoInstance);
            }
          },
          {
            timeout: 15000,
            maximumAge: 0,
            enableHighAccuracy: true
          }
        );
      }

      function sendLocation(pos, instance) {
        const context = savedContext;
        const oldSkills = context.skills || {};
        const newSkills = {};

        Object.entries(oldSkills).forEach(([skillName, skillData]) => {
          newSkills[skillName] = {
            ...skillData,
            skill_variables: {
              ...(skillData.skill_variables || {}),
              latitude: pos.coords.latitude,
              longitude: pos.coords.longitude
            }
          };
        });

        const payload = {
          input: {
            text: "Ok I've shared my location.",
            options: { return_context: true }
          },
          context: { ...context, skills: newSkills }
        };

        instance.send(payload);
      }

      function sendLocationError(err, instance) {
        const msg =
          err.code === err.PERMISSION_DENIED
            ? "I don't want to share my location at this time."
            : err.code === err.POSITION_UNAVAILABLE
            ? "I wasn’t able to get a precise location. Could you enter your postcode?"
            : err.code === err.TIMEOUT
            ? "Getting your location timed out—could you please enter your postcode?"
            : "There was an error sharing my location.";

        alert(msg);
        instance.send({
          input: {
            text: msg,
            options: { return_context: true }
          }
        });
      }

      function receiveHandler(event, instance) {
        geoInstance = instance;
        savedContext = event.data.context || {};

        (event.data.output.generic || []).forEach(item => {
          if (
            item.response_type === "user_defined" &&
            item.user_defined?.user_defined_type === "share_location"
          ) {
            tryGeo();
          }
        });
      }

      async function onLoad(instance) {
        instance.on({ type: "receive", handler: receiveHandler });
        await instance.render();
      }

      window.watsonAssistantChatOptions = {
        integrationID: "2146349f-ef06-4e9d-ad65-c7846775c0b6",
        region: "eu-gb",
        serviceInstanceID: "a3a6beaa-5967-4039-8390-d48ace365d86",
        onLoad: onLoad
      };

      const s = document.createElement("script");
      s.src = `https://web-chat.global.assistant.watson.appdomain.cloud/versions/${
        window.watsonAssistantChatOptions.clientVersion || "latest"
      }/WatsonAssistantChatEntry.js`;
      document.head.appendChild(s);
    </script>
  </body>
</html>
